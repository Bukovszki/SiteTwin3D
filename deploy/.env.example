# Deployment settings. Copy to .env and fill in:  cp .env.example .env
# .env holds secrets: keep it out of git (.gitignore excludes it), permissions 600.
# Every password must be long and random. Generate: openssl rand -base64 24

# Server DNS name (A record pointing to the server's public IP); local machine: localhost
DOMAIN=localhost
# The address users open (signed object URLs are made for it); local machine: https://localhost:8543
PUBLIC_URL=https://localhost:8543
# Let's Encrypt notification address (required; for localhost any address will do, no certificate is requested)
ACME_EMAIL=admin@localhost

# PostgreSQL + PostGIS (the API works with this user; not reachable from outside)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# The first platform admin (sign-in: organization = "platform"); at least 8 characters, must be changed at first sign-in
PLATFORM_ADMIN_USER=admin
PLATFORM_ADMIN_PASSWORD=

# S3-compatible object store (panoramas, 3D models): admin key pair used by the API
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Largest panorama upload (MB)
MAX_PANORAMA_MB=300
# Largest 3D model upload: a GLB or all files of a 3D Tiles package (MB)
MAX_MODEL_MB=4096
# Object store housekeeping (hours): run interval, grace period of unreferenced files; true = report only
CLEANUP_INTERVAL_HOURS=6
CLEANUP_GRACE_HOURS=24
CLEANUP_DRY_RUN=false
# Backups (backup.sh): target folder and how many database dumps to keep
BACKUP_DIR=./backups
BACKUP_KEEP=14

# Pinned images (update only after a backup and a trial run)
# POSTGIS_IMAGE=docker.io/kartoza/postgis:16-3.4
# STORAGE_IMAGE=docker.io/chrislusf/seaweedfs:4.48
